[Unit]
Description=Ungenutzte PCI-Geraete entfernen (Thunderbolt, Audio, Kamera)
# These devices have no driver (modules are blacklisted) but stay in the PCI
# tree in D0 -- they draw power doing nothing and are dragged through every
# suspend.
#
#   05:00.0  Thunderbolt 2 bridge (DSL5520), takes the whole 06-9b tree along.
#            Measured ~510 ms per suspend cycle (2026-08-31).
#   00:03.0  HDMI audio      \ snd_hda_intel is blacklisted; in suspend they
#   00:1b.0  HD audio        / cost only ~0.2 ms -- this is about D0.
#   02:00.0  FaceTime camera, facetimehd is blacklisted.
#
# Do not touch: 03:00.0 (wifi, below root port 00:1c.2) and 00:14.0 (xHCI --
# internal keyboard and trackpad hang off it).
DefaultDependencies=no
After=sysinit.target
Before=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pci-remove-unused.sh

[Install]
WantedBy=basic.target
