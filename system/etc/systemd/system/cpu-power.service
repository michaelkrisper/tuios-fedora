[Unit]
Description=CPU-Politik setzen (ersetzt den auto-cpufreq-Daemon)
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Governor: on intel_pstate, powersave scales with load by itself.
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo powersave > $g; done'
# Turbo ON: only raises the ceiling under load (2400 -> 2900 MHz); when idle the
# CPU still sits at 800 MHz in C9/C10. Turn it off deliberately for long
# full-load runs.
ExecStart=/bin/sh -c 'echo 0 > /sys/devices/system/cpu/intel_pstate/no_turbo'
# Energy Performance Bias 15 (most power-saving value). Used to live in the
# separate cpu-powersave.service -- disabled on 2026-08-31 because it also set
# no_turbo=1 and so contradicted this unit. Which one won depended on start
# order.
ExecStart=/bin/sh -c 'for b in /sys/devices/system/cpu/cpu*/power/energy_perf_bias; do echo 15 > $b; done'

[Install]
WantedBy=multi-user.target
