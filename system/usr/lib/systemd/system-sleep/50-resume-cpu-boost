#!/usr/bin/env bash
# system-sleep hook: on "post" (resume) kick off a short CPU boost in the
# background. systemd-run -> non-blocking, resume itself is not delayed.
case "$1" in
    post)
        systemd-run --quiet --collect \
            --unit=resume-cpu-boost \
            --description="Kurzer CPU-Boost nach Resume" \
            /usr/local/sbin/resume-cpu-boost.sh
        ;;
esac
