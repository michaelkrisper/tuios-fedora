#!/usr/bin/env bash
# Turn SMT off across suspend.
#
# cpu2 and cpu3 are the HyperThreading siblings of cpu0 and cpu1. Bringing them
# up in the resume path costs ~2.3 s: the kernel does it synchronously in
# suspend_enable_secondary_cpus() before continuing, and the individual cpuhp
# callbacks (cacheinfo_cpu_online, sched_cpu_activate, ...) each wait hundreds
# of milliseconds there -- presumably for RCU grace periods while hardly any
# CPUs are online.
#
# On a running system the same operation costs almost nothing: off 131 ms,
# on 51 ms (measured 2026-08-31). So off before, back on in the background
# afterwards -- instead of sacrificing SMT permanently with nosmt.
case "$1" in
    pre)
        echo off > /sys/devices/system/cpu/smt/control
        ;;
    post)
        # via systemd-run, so resume does not wait for it and the process is not
        # cleaned up together with systemd-suspend.service.
        # shellcheck disable=SC2016  # expanded by the inner sh
        systemd-run --quiet --collect \
            --unit=smt-restore \
            --description="HyperThreading nach Resume wieder aktivieren" \
            /bin/sh -c 'echo on > /sys/devices/system/cpu/smt/control; logger "smt-defer: SMT wieder an ($(cat /sys/devices/system/cpu/online))"'
        ;;
esac
