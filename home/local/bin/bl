#!/usr/bin/env bash
# bl [0-100] - display brightness in percent, decimals allowed (bl 0.2)
#
# The device name is not hard-wired: with _OSI(Darwin) the backlight is
# acpi_video0 (100 steps), without Darwin intel_backlight (1388 steps).
# brightnessctl does not care which one exists -- and needs no sudo, because
# it gets access via logind/udev.
#
# Percent is converted to raw values here: brightnessctl truncates the decimals
# of "0.2%", and with 1388 steps there is plenty of usable range below 1 %
# (raw value 1 works).
set -u
read -r _ _ cur _ max < <(brightnessctl -m | tr ',' ' ')
show() { awk -v c="$1" -v m="$2" 'BEGIN{printf "%.1f%%\n", c*100/m}'; }
if [ $# -eq 0 ]; then
    show "$cur" "$max"
else
    raw=$(awk -v p="$1" -v m="$max" 'BEGIN{
        v = int(p*m/100 + 0.5)
        if (v < 0) v = 0; if (v > m) v = m
        if (v == 0 && p > 0) v = 1        # deliberately dark, but not off
        print v }')
    brightnessctl -q set "$raw"
    show "$raw" "$max"
fi
