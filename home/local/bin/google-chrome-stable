#!/bin/sh
# Fedoras /usr/bin/google-chrome-stable ignoriert ~/.config/chrome-flags.conf
# (das liest nur der Arch-Wrapper). Hier nachgeruestet: eine Flag pro Zeile, # = Kommentar.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/chrome-flags.conf"
flags=
[ -r "$conf" ] && flags=$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$conf")
# shellcheck disable=SC2086  # Flags sollen an Leerraum zerfallen
exec /opt/google/chrome/google-chrome $flags "$@"
