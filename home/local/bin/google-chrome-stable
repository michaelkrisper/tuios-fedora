#!/bin/sh
# Fedora's /usr/bin/google-chrome-stable ignores ~/.config/chrome-flags.conf
# (only the Arch wrapper reads it). Added here: one flag per line, # = comment.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/chrome-flags.conf"
flags=
[ -r "$conf" ] && flags=$(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$conf")
# shellcheck disable=SC2086  # flags are meant to split on whitespace
exec /opt/google/chrome/google-chrome $flags "$@"
